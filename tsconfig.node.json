{
  // Code Node runs: the reception server, the command-line tools, the build script and the tests.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "tools/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "vite*.config.ts", "shared/globals.d.ts"]
}
