{
  "firestore": {
    "rules": "firebase/firestore.rules"
  },
  "hosting": {
    "public": "dist/hosting",
    "predeploy": ["npm run build"],
    "ignore": ["**/.*", "**/*.md"],
    "redirects": [
      { "source": "/", "destination": "/register/", "type": 302 }
    ],
    "headers": [
      { "source": "**/*.@(js|html|css)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  }
}
