{
  "name": "time-space-voyage",
  "version": "1.0.0",
  "private": true,
  "description": "Hand-gesture exploration of space today and the Moon in 2126 (未来創造展)",
  "type": "module",
  "scripts": {
    "start": "node server/server.mjs",
    "start:lan": "node -e \"process.env.HOST='0.0.0.0'; import('./server/server.mjs')\"",
    "deploy": "firebase deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "build": "node scripts/build.mjs",
    "build:dev": "node scripts/build.mjs --env dev",
    "test:integration": "node tests/integration/api.mjs && node tests/integration/checkin-race.mjs",
    "test:e2e": "node tests/e2e/pages.mjs && node tests/e2e/contract.mjs && node tests/e2e/checkin.mjs && node tests/e2e/cancel.mjs && node tests/e2e/booth.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "firebase": "12.19.0",
    "qrcode-generator": "^1.4.4",
    "three": "0.170.0"
  },
  "optionalDependencies": {
    "firebase-admin": "14.5.0",
    "mariadb": "3.5.4"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
